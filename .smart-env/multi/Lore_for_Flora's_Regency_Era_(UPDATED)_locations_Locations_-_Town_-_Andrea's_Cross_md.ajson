
"smart_sources:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Town - Andrea's Cross.md": {"path":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Town - Andrea's Cross.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"v1m8tu","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1776992827696,"size":1948,"at":1777331817922,"hash":"v1m8tu"},"blocks":{"#---frontmatter---":[1,19],"#Locations - Town - Andrea's Cross":[21,22],"#A large, rural county in western Flora, considered provincial by the rest of the nation.":[23,31],"#A large, rural county in western Flora, considered provincial by the rest of the nation.#{1}":[24,31]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["andrea's cross","crosser","crossgal","western flora","cowboy"],"position":"before","depth":4,"scanDepth":1,"summary":"**Andrea's Cross** is a rural, provincial county in western Flora. Select this entry when the user's query involves a character or location from this region, specifically for contrasts with eastern Floren nobility, or when referencing Estra Hamilton's \"hot bumpkin\" cover identity. The county is known for ranching and farming, a culture of rugged individualism and hard work (with gallant Crossgals as dashing pursuers in romance), and deep religious conviction. Key relationships: defined in opposition to \"stuck-up\" eastern nobles; home to Crossgals; Estra Hamilton uses it for her cover persona."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Town - Andrea's Cross.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"vhihbo","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Town - Andrea's Cross.md#---frontmatter---","lines":[1,19],"size":828,"outlinks":[],"class_name":"SmartBlock"},
