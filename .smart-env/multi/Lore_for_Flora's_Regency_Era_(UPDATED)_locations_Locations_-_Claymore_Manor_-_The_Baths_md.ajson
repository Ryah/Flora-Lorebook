
"smart_sources:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Baths.md": {"path":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Baths.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"5c6zu3","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777016026216,"size":2170,"at":1777331817922,"hash":"5c6zu3"},"blocks":{"#---frontmatter---":[1,22],"#Locations - Claymore Manor - The Baths":[24,25],"#The communal bathing facilities and customs at the Claymore estate.":[26,37],"#The communal bathing facilities and customs at the Claymore estate.#{1}":[27,37]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["bath","bathing","bathe","shower","mistress bath","communal bath"],"position":"before","cascade_links":["Claymore Manor"],"depth":4,"scanDepth":1,"summary":"**Claymore Manor Baths**  \nCommunal bathing facilities at the Claymore estate. Used whenever a character bathes, soaks, or socializes in water. Two locations: **Mistress Bath** (family & honored guests, elegant, multiple baths, maids in swimsuit uniform) and **Servants Bath** (larger, simpler, near commons). Bathing culture: traditionally communal with modest sex segregation. Water supplied by Loren's tower system, later improved by Charlotte.  \n**Select when:** a character bathes, visits the baths, discusses bathing customs, or a maid attends bathers.  \n**Key relationships:** Loren (installed water tower), Charlotte (improved pump), maids (relax with employers)."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Baths.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1vv9lot","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Baths.md#---frontmatter---","lines":[1,22],"size":936,"outlinks":[],"class_name":"SmartBlock"},
