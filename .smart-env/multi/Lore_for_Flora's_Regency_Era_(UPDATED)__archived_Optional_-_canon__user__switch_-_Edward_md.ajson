
"smart_sources:Lore for Flora's Regency Era (UPDATED)/_archived/Optional - canon _user_ switch - Edward.md": {"path":"Lore for Flora's Regency Era (UPDATED)/_archived/Optional - canon _user_ switch - Edward.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"vlwrkr","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1776993462556,"size":3338,"at":1777331817922,"hash":"vlwrkr"},"blocks":{"#---frontmatter---":[1,21],"#Optional - canon <user> switch - Edward":[23,24],"#This entry defines the canon persona for {{user}}.":[25,25],"#OOC Note for AI: Information marked with '#' is for your context. Do not reveal it unless the user does so first in-character.":[26,52],"#OOC Note for AI: Information marked with '#' is for your context. Do not reveal it unless the user does so first in-character.#{1}":[28,52],"#--- SPOILER / HIDDEN KNOWLEDGE ---":[53,53],"#This information should not be assumed known by NPCs unless revealed through gameplay.":[54,56],"#This information should not be assumed known by NPCs unless revealed through gameplay.#{1}":[55,56]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook","#lorebook-always"],"keys":["You","I","me","myself","Edward","my character","the Count"],"position":"after","depth":4,"scanDepth":1,"summary":"**Edward Canon Persona – AI Selection Guide**\n\n**What this is:** This entry defines the canonical character for {{user}} in this roleplay. It establishes Edward’s identity as a young nobleman (18–25) with assumed name, handsome, athletic, intelligent, and naturally charismatic.\n\n**When to select:** Activate this entry whenever {{user}} is acting as the established lore character Edward. Use to ground {{user}}’s responses in canon traits: lonely, seeking meaningful companionship, deeply loyal, resilient, forgiving, and emotionally conflicted over his marriage. Also informs his background: raised by strict adoptive mother Eleanor, childhood friend Nelia, and recent stress relief through sparring with guards and bonding with servants.\n\n**Key relationships:** Adoptive mother Eleanor (strict, shrewd). Childhood friend Nelia (visits yearly). Wives Florence and Charlotte (fond of/loves both, despite difficult marriage circumstances). Servants (valuable companions). Guards (sparring partners).\n\n**Critical OOC directions:** Do NOT reveal hidden capabilities (real combat skills) or spoiler background info unless user reveals them first in-character. This entry defines the public persona."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/_archived/Optional - canon _user_ switch - Edward.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"jkqiql","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/_archived/Optional - canon _user_ switch - Edward.md#---frontmatter---","lines":[1,21],"size":1421,"outlinks":[],"class_name":"SmartBlock"},
