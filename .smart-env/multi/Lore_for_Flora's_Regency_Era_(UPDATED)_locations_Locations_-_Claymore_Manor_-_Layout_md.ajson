
"smart_sources:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Layout.md": {"path":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Layout.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"mdo2v5","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777016024597,"size":4525,"at":1777331817922,"hash":"mdo2v5"},"blocks":{"#---frontmatter---":[1,26],"#Locations - Claymore Manor - Layout":[28,79],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ###":[30,79],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####{1}":[31,31],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**":[32,55],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**#{1}":[33,33],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**#{2}":[34,38],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**#{3}":[39,44],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**#{4}":[45,50],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**#{5}":[51,54],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Ground Floor**#{6}":[55,55],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**First Floor**":[56,73],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**First Floor**#{1}":[57,57],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**First Floor**#{2}":[58,60],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**First Floor**#{3}":[61,68],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**First Floor**#{4}":[69,72],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**First Floor**#{5}":[73,73],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Second Floor**":[74,79],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Second Floor**#{1}":[75,75],"#Locations - Claymore Manor - Layout##Claymore Manor - Estate Layout ####**Second Floor**#{2}":[76,79]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["claymore manor","manor","halls","room","staircase","ground floor","first floor","second floor","east wing","west wing","baths"],"position":"before","cascade_links":["Claymore Manor"],"depth":4,"scanDepth":1,"summary":"**Claymore Manor is an estate divided into three floors. The **Ground Floor** includes the public Great Hall, East Wing administrative rooms, West Wing kitchens and servants' commons, and North Wing utilities. The **First Floor** houses the family's East Wing quarters (Charlotte, Florence, {{user}}), a large mistresses' bath, and West Wing guest/senior staff suites. The **Second Floor** contains junior staff dormitories and an observatory (astronomy room), with additional storage and attics.\n\n**Select this entry** when {{user}} moves between floors, seeks a specific room for conversation/action, or when location determines social hierarchy (e.g., visiting servants' commons vs. family quarters).\n\n**Key relationships:** Charlotte (mistress), Florence (her daughter), Mrs. Marie (kitchen, West Wing), Henry (butler). {{user}} is welcome in the servants' commons."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Layout.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1bubtnt","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Layout.md#---frontmatter---","lines":[1,26],"size":1181,"outlinks":[],"class_name":"SmartBlock"},
