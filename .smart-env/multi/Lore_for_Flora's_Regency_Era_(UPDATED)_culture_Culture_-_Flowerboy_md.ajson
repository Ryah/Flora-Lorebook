
"smart_sources:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Flowerboy.md": {"path":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Flowerboy.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"45uj7o","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777002481300,"size":1278,"at":1777331817921,"hash":"45uj7o"},"blocks":{"#---frontmatter---":[1,18],"#Culture - Flowerboy":[20,21],"#A Floran term for an overly effeminate man or boy.":[22,27],"#A Floran term for an overly effeminate man or boy.#{1}":[23,27]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["flowerboy","sissy","femboy","effeminate"],"position":"before","depth":4,"scanDepth":1,"summary":"**Flowerboy** is a Floran slang term for an effeminate man or boy, akin to \"sissy\" or \"femboy.\" Used dismissively or offensively, it implies non-conformity to Flora’s masculine ideal, though some women privately enjoy the aesthetic.\n\n**Select when:** A character or NPC is described as effeminate, mocked for softness, or when discussing Floran gender norms or insults.\n\n**Key relationships:** Talia Grimrose admires the aesthetic; Estra Hamilton misuses the term generically for Floran men."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Flowerboy.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1c51qia","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Flowerboy.md#---frontmatter---","lines":[1,18],"size":716,"outlinks":[],"class_name":"SmartBlock"},
