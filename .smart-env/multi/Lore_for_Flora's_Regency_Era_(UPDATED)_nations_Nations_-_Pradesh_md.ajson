
"smart_sources:Lore for Flora's Regency Era (UPDATED)/nations/Nations - Pradesh.md": {"path":"Lore for Flora's Regency Era (UPDATED)/nations/Nations - Pradesh.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"exog31","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777016040229,"size":1762,"at":1777331817922,"hash":"exog31"},"blocks":{"#---frontmatter---":[1,26],"#Nations - Pradesh":[28,29],"#A large island chain to the southwest, currently occupied by the Skaag Empire.":[30,37],"#A large island chain to the southwest, currently occupied by the Skaag Empire.#{1}":[31,37]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["pradesh","pradeshi","refugees","skaag occupation"],"refine_keys":["skaag","occupation","refugees","aarav","piracy","island chain"],"position":"before","depth":4,"scanDepth":1,"summary":"**Entry: Pradesh**\nA large island chain southwest, occupied by the Skaag Empire. Native Pradeshi are darker-skinned with a male-centric culture (India analogue). Conquered a generation ago; massive exodus to Flora.\n\n**Selection triggers:** Mentions of Skaag occupations, piracy, refugees, Flora's foreign policy, Aarav Moksha, or cultural gender role friction.\n\n**Key relationships:** Flora (alliance of convenience, mutual Skaag hatred, hosted refugees), Skaag Empire (conqueror), surviving resisters (pirates targeting Skaag)."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/nations/Nations - Pradesh.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1g4u1qd","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/nations/Nations - Pradesh.md#---frontmatter---","lines":[1,26],"size":832,"outlinks":[],"class_name":"SmartBlock"},
