
"smart_sources:Flora - Memory Books/Arcs/[ARC 006] - The Achilles Severance and the Lemon Cipher.md": {"path":"Flora - Memory Books/Arcs/[ARC 006] - The Achilles Severance and the Lemon Cipher.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1glyy82","at":1777331817896},"class_name":"SmartSource","last_import":{"mtime":1777075055411,"size":3892,"at":1777331817922,"hash":"1glyy82"},"blocks":{"#---frontmatter---":[1,23],"#[ARC 006] - The Achilles Severance and the Lemon Cipher":[25,26],"#The Achilles Severance and the Lemon Cipher":[27,55],"#The Achilles Severance and the Lemon Cipher#{1}":[28,31],"#The Achilles Severance and the Lemon Cipher#Major Beats":[32,40],"#The Achilles Severance and the Lemon Cipher#Major Beats#{1}":[33,33],"#The Achilles Severance and the Lemon Cipher#Major Beats#{2}":[34,34],"#The Achilles Severance and the Lemon Cipher#Major Beats#{3}":[35,35],"#The Achilles Severance and the Lemon Cipher#Major Beats#{4}":[36,36],"#The Achilles Severance and the Lemon Cipher#Major Beats#{5}":[37,37],"#The Achilles Severance and the Lemon Cipher#Major Beats#{6}":[38,38],"#The Achilles Severance and the Lemon Cipher#Major Beats#{7}":[39,40],"#The Achilles Severance and the Lemon Cipher#Character Dynamics":[41,43],"#The Achilles Severance and the Lemon Cipher#Character Dynamics#{1}":[42,43],"#The Achilles Severance and the Lemon Cipher#Key Exchanges":[44,48],"#The Achilles Severance and the Lemon Cipher#Key Exchanges#{1}":[45,45],"#The Achilles Severance and the Lemon Cipher#Key Exchanges#{2}":[46,46],"#The Achilles Severance and the Lemon Cipher#Key Exchanges#{3}":[47,48],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity":[49,55],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity#{1}":[50,50],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity#{2}":[51,51],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity#{3}":[52,52],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity#{4}":[53,53],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity#{5}":[54,54],"#The Achilles Severance and the Lemon Cipher#Outcome & Continuity#{6}":[55,55]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["Achilles Severance","Lemon Cipher","Valheim","Loren","Ryan","Eleanor Adame","Sea Witch","Alexander Valdemar","Claymore","Duranian Prince","conditioning program","pigeon message"],"position":"after","depth":4,"summary":"**What:** An 1843 household investigation revealing Ryan's true identity as Prince Darian of Duran and exposing a 15-year conditioning program by Loren to weaponize his gratitude.\\n\\n**When:** Select for Thursday, June 15, 1843, 7:05 PM to 8:40 PM, specifically during the investigation of a carrier pigeon and the decoding of a cipher.\\n\\n**Relationships:** Features a power shift where Cora asserts cryptographic authority over Charlotte, and Ryan transitions from victim to tactical leader, establishing a collective defense framework (\\\"blade,\\\" \\\"intelligence,\\\" etc.).\\n\\n**Continuity:** Exposes a 21-day extraction deadline (June 30) and identifies Estra Hamilton as an embedded assassin."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/Arcs/[ARC 006] - The Achilles Severance and the Lemon Cipher.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1j8wiex","at":1777331817896},"key":"Flora - Memory Books/Arcs/[ARC 006] - The Achilles Severance and the Lemon Cipher.md#---frontmatter---","lines":[1,23],"size":1020,"outlinks":[],"class_name":"SmartBlock"},
