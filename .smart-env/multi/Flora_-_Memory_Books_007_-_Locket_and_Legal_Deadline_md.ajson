arlotte"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/007 - Locket and Legal Deadline.md#---frontmatter---": {"path":null,"last_embed":{"hash":"jin79c","at":1777331861979},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04167403,-0.03999719,0.01423575,-0.01024481,0.00556432,0.04781917,0.07096051,-0.02386475,-0.01364907,0.00065893,-0.04239408,-0.01978443,-0.00214512,0.03490545,0.03717766,0.04676184,0.00437382,0.0499252,-0.07447042,0.06281439,0.01254387,-0.05127286,-0.03171111,-0.00344639,0.00247629,-0.02238377,-0.06149081,-0.01910576,-0.09784247,-0.21739435,-0.03360748,-0.00799955,0.01488507,0.02501674,0.0442264,-0.01913643,-0.05313658,0.04457912,0.02105816,-0.02078725,0.02345797,0.00855083,-0.0241322,0.01197511,-0.00092084,-0.08079636,0.03637553,-0.00736772,0.03291524,-0.07030243,-0.06107507,-0.02032144,0.04201253,-0.00056169,0.01599262,0.01033739,0.10681979,0.0029152,0.06067199,0.03790062,0.09724112,-0.00895173,-0.19824202,0.10058521,0.03601366,0.01933341,-0.01522282,-0.07656147,0.03490592,-0.03212225,0.0098927,0.05588818,-0.0121081,0.04451856,0.04582729,0.01580423,0.03444944,-0.0046831,0.02225846,-0.01951707,-0.05727059,0.0346291,-0.00239055,0.04889838,-0.05255097,0.02064313,0.02274527,-0.04061267,-0.02043483,0.00496082,-0.05361719,-0.06633689,-0.05328366,0.05092561,-0.06334241,-0.03755313,-0.02063548,0.02960981,-0.07991367,0.07264463,-0.02021767,0.0343812,-0.00818242,-0.00626847,0.07776604,-0.01573125,0.03738555,-0.12983072,-0.01238515,0.00368413,0.05199204,0.00494013,0.0484567,-0.03170796,0.02586063,0.08485445,0.13594522,0.03308194,-0.02601918,0.0077987,0.01971057,0.03442071,0.0178492,-0.007474,-0.01772609,-0.03820116,0.07470097,0.05659659,0.0353344,-0.02475855,0.0052087,0.02029932,-0.01014405,0.01847634,0.03291544,0.03384658,-0.04116305,-0.01744977,-0.02010428,-0.08424304,-0.08639892,-0.09562617,-0.02542757,-0.00229111,-0.03863605,0.11121826,0.00947028,0.02272513,0.01300896,0.01933278,-0.05425581,0.0056086,-0.00930412,