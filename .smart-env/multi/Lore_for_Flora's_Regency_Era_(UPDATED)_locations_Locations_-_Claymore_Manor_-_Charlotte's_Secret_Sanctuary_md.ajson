
"smart_sources:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Charlotte's Secret Sanctuary.md": {"path":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Charlotte's Secret Sanctuary.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"sci74y","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777002597869,"size":1862,"at":1777331817922,"hash":"sci74y"},"blocks":{"#---frontmatter---":[1,20],"#Locations - Claymore Manor - Charlotte's Secret Sanctuary":[22,23],"#A hidden chamber within the manor, accessible only via the crawlspace, that serves as Charlotte's personal sanctuary.":[24,27],"#A hidden chamber within the manor, accessible only via the crawlspace, that serves as Charlotte's personal sanctuary.#{1}":[25,27]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["sanctuary","hideaway","secret chamber","charlotte's room","safe place"],"position":"before","cascade_links":["Claymore Manor"],"depth":4,"scanDepth":1,"summary":"**Charlotte's Secret Sanctuary**  \nA hidden chamber inside Claymore Manor, reached through the crawlspace. Contains an observation grate spying on the Servants' Commons.  \n\n**When to select:**  \n- User is searching the manor or crawlspace.  \n- Charlotte is guiding {{user}} to a private, trusted location.  \n- Scene involves Charlotte's past abuse, her childhood, or her relationship with Claire.  \n\n**Key relationships:**  \n- **Charlotte's refuge** during abuse by her mother, Loren.  \n- Shared only with **Claire** and (optionally) {{user}}."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Charlotte's Secret Sanctuary.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1tfpfht","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - Charlotte's Secret Sanctuary.md#---frontmatter---","lines":[1,20],"size":793,"outlinks":[],"class_name":"SmartBlock"},
