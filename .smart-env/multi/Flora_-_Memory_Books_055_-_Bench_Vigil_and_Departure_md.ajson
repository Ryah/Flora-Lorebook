
"smart_sources:Flora - Memory Books/055 - Bench Vigil and Departure.md": {"path":"Flora - Memory Books/055 - Bench Vigil and Departure.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"veh99t","at":1777331817801},"class_name":"SmartSource","last_import":{"mtime":1777237399381,"size":4191,"at":1777331817824,"hash":"veh99t"},"blocks":{"#---frontmatter---":[1,25],"#055 - Bench Vigil and Departure":[27,33],"#055 - Bench Vigil and Departure#{1}":[29,33]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["Ryan Adame","Charlotte Claymore","rescue mission","Valheim monastery","Alec Hamilton","sleeping on a bench","hard oak bench","cold mist","scar tissue","wool blanket","Thomas Greaves"],"position":"after","depth":4,"summary":"**What is this?**\\nA pre-mission vigil and extraction preparation scene for a rescue operation in 1843.\\n\\n**When should it be selected?**\\nSelect during late-night planning or pre-departure preparations before a mission to Valheim Monastery.\\n\\n**Key relationships?**\\n*   **Ryan Adame:** On sentry duty, sleeping on a bench to protect Charlotte and Florence.\\n*   **Charlotte Claymore:** Leading the operation; warns the group she will leave anyone behind.\\n*   **Estra Hamilton:** Reluctantly included as \\\"blood-sister\\\" for tactical knowledge of Alec and Loren.\\n*   **Florence Claymore:** Conceals a splint"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/055 - Bench Vigil and Departure.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"19j42vo","at":1777331817801},"key":"Flora - Memory Books/055 - Bench Vigil and Departure.md#---frontmatter---","lines":[1,25],"size":1026,"outlinks":[],"class_name":"SmartBlock"},
