
"smart_sources:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Wedding Traditions.md": {"path":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Wedding Traditions.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"du3hhi","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777002481309,"size":1953,"at":1777331817922,"hash":"du3hhi"},"blocks":{"#---frontmatter---":[1,25],"#Culture - Wedding Traditions":[27,28],"#The traditional wedding customs of the hamlet of Yorenia in Aspen County, and possibly Flora at large.":[29,34],"#The traditional wedding customs of the hamlet of Yorenia in Aspen County, and possibly Flora at large.#{1}":[30,34]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["wedding traditions","wedding"],"refine_keys":["ceremony","vows","bride","groom","dowry","nuptials","betrothal","yorenia"],"position":"before","depth":4,"scanDepth":1,"summary":"**Yorenian Wedding Traditions** – Select when a wedding, festival, or community gathering occurs in Yorenia (or rural Flora). Covers 3-day village-wide celebration involving all residents. Key practices: women weave garlands (lupin, columbine, forget-me-nots), men build pavilions, feast includes consecrated goats (whose fur is given to the bride for baby swaddling). Strangers are welcomed as family. Notable relationship: childless couples/officially watch village children, symbolizing shared divine responsibility for \"Althena's children.\" Use to inject cultural flavor, community norms, or divine/reproductive themes."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Wedding Traditions.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1tefpbk","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Wedding Traditions.md#---frontmatter---","lines":[1,25],"size":913,"outlinks":[],"class_name":"SmartBlock"},
