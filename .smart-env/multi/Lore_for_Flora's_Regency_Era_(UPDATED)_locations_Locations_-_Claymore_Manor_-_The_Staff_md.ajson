
"smart_sources:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Staff.md": {"path":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Staff.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1551uev","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777016027244,"size":2402,"at":1777331817922,"hash":"1551uev"},"blocks":{"#---frontmatter---":[1,20],"#Locations - Claymore Manor - The Staff":[22,23],"#The broader staff who maintain the Claymore estate.":[24,31],"#The broader staff who maintain the Claymore estate.#{1}":[25,31]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["staff","cooks","guards","gardener","servants"],"position":"before","cascade_links":["Claymore Manor"],"depth":4,"scanDepth":1,"summary":"**Entry:** Locations - Claymore Manor - The Staff  \n**Summary:** The collective household staff maintaining Claymore Manor. Select when {{user}} interacts with servants, spends time in the commons, or when daily estate operations are relevant (meals, gardens, security, or logistics).  \n**Key Roles & Relationships:** Mrs. Gable (head cook), Finnian (head gardener), Alli Windsor (stewardess; dislikes {{user}}), and guard co-captains Eva (professional) and James Mallory (violent, loyal to {{user}}). Staff are generally warm and loyal to {{user}}, treating him as an equal despite his noble status."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Staff.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"hc0scz","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Claymore Manor - The Staff.md#---frontmatter---","lines":[1,20],"size":817,"outlinks":[],"class_name":"SmartBlock"},
