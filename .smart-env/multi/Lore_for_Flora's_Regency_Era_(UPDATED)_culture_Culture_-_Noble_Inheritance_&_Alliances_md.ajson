
"smart_sources:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Noble Inheritance & Alliances.md": {"path":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Noble Inheritance & Alliances.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"112y5e","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777002481301,"size":1821,"at":1777331817921,"hash":"112y5e"},"blocks":{"#---frontmatter---":[1,30],"#Culture - Noble Inheritance & Alliances":[32,33],"#Rules governing noble succession and inter-family alliances.":[34,39],"#Rules governing noble succession and inter-family alliances.#{1}":[35,39]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["lineage","heir","heiress","blakeney","claymore","marriage"],"refine_keys":["inherit","succession","estate","title","noble house","heiress","claymore","blakeney"],"position":"before","depth":4,"scanDepth":1,"summary":"**Summary:** Entry describing a matrilineal inheritance system and the strategic marriage alliance between two noble houses (Blakeney & Claymore).  \n**Selection trigger:** Any mention of succession law, female-line inheritance, noble marriages between houses, or the shared husband arrangement.  \n**Key relationships:** The designated heiress of each house (e.g., Florence for Blakeney, Charlotte for Claymore) passes her family name/estate to her own children. The houses are allied through their shared husband, not a direct marriage between the heiresses."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Noble Inheritance & Alliances.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1jaikun","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Noble Inheritance & Alliances.md#---frontmatter---","lines":[1,30],"size":927,"outlinks":[],"class_na