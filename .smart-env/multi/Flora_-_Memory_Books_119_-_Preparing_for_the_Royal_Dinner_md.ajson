
"smart_sources:Flora - Memory Books/119 - Preparing for the Royal Dinner.md": {"path":"Flora - Memory Books/119 - Preparing for the Royal Dinner.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1sd3d9s","at":1777331817827},"class_name":"SmartSource","last_import":{"mtime":1777330999777,"size":3043,"at":1777331817893,"hash":"1sd3d9s"},"blocks":{"#---frontmatter---":[1,27],"#119 - Preparing for the Royal Dinner":[29,30],"#119 - Preparing for the Royal Dinner#{1}":[30,30]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["June 21 1843 royal dinner preparation","Estra Hamilton visible karambit permission","Ryan Adame Duranian formal wear","Charlotte Claymore tactical seating chart","Florence Claymore corridor insistence","Queen Maya emotional acknowledgment","Bonnie Prince Charlie punctuality joke","Palace Great Hall court assembly","family visibility strategy Loren","guards visible reaction doors","my son royal declaration","weapon narrative control"],"position":"after","depth":4,"summary":"Lore entry for the family’s preparation and entrance to the formal royal dinner on June 21, 1843. Inject when the scene reaches the West Wing Suite just before the dinner or when the family needs to enter the great hall. Covers the decision to openly wear Estra’s karambit, Ryan’s public-visibility strategy against Loren’s threat, dressing in Duranian formal wear, Charlotte’s tactical seating chart, and the family’s procession to the high table where Queen Maya emotionally acknowledges Ryan as “my son.” Key family members present: Mina, Cora, Alec, Rachael, Howard, William Adame.","location":"Duran","scene_type":"dialogue","character_present":["Ryan","Charlotte","Florence","Estra","Queen Maya"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/119 - Preparing for the Royal Dinner.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length"