
"smart_sources:Flora - Memory Books/Arcs/[ARC 001] - Arrival, Confession, and Rescue Plan.md": {"path":"Flora - Memory Books/Arcs/[ARC 001] - Arrival, Confession, and Rescue Plan.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"ndp7c3","at":1777331817896},"class_name":"SmartSource","last_import":{"mtime":1777075049400,"size":4865,"at":1777331817922,"hash":"ndp7c3"},"blocks":{"#---frontmatter---":[1,25],"#[ARC 001] - Arrival, Confession, and Rescue Plan":[27,28],"#Arrival, Confession, and Rescue Plan":[29,61],"#Arrival, Confession, and Rescue Plan#{1}":[30,33],"#Arrival, Confession, and Rescue Plan#Major Beats":[34,42],"#Arrival, Confession, and Rescue Plan#Major Beats#{1}":[35,35],"#Arrival, Confession, and Rescue Plan#Major Beats#{2}":[36,36],"#Arrival, Confession, and Rescue Plan#Major Beats#{3}":[37,37],"#Arrival, Confession, and Rescue Plan#Major Beats#{4}":[38,38],"#Arrival, Confession, and Rescue Plan#Major Beats#{5}":[39,39],"#Arrival, Confession, and Rescue Plan#Major Beats#{6}":[40,40],"#Arrival, Confession, and Rescue Plan#Major Beats#{7}":[41,42],"#Arrival, Confession, and Rescue Plan#Character Dynamics":[43,45],"#Arrival, Confession, and Rescue Plan#Character Dynamics#{1}":[44,45],"#Arrival, Confession, and Rescue Plan#Key Exchanges":[46,53],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{1}":[47,47],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{2}":[48,48],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{3}":[49,49],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{4}":[50,50],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{5}":[51,51],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{6}":[52,53],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity":[54,61],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{1}":[55,55],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{2}":[56,56],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{3}":[57,57],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{4}":[58,58],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{5}":[59,59],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{6}":[60,60],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{7}":[61,61]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["Eleanor Adame","Claymore Manor","Competition Petition","Smuggler's Path","Hidden Chamber","Abuse","Hostage","Kidnapping Rescue","Eleanor","Ryan","Mina","Cora","Rachael Blakeney","Blanket Code"],"position":"after","depth":4,"summary":"**What:** A narrative arc detailing Ryan's arrival at Claymore Manor, his confession of abuse by his mother Eleanor, and the formulation of a rescue plan for his sisters Mina and Cora.\\n\\n**When:** Wednesday, June 14, 1843, 2:15 PM to Thursday, June 15, 1843, 6:40 AM.\\n\\n**Context:** Ryan, suffering amnesia from a carriage accident, exposes Eleanor's torture chamber and manipulation. He unites with Rachael, Charlotte, and Florence to plan a surgical extraction using a smuggler's path, despite facing legal challenges and external threats.\\n\\n**Key Relationships:** Ryan gains a protective maternal bond with Rachael and a strategic alliance with Charlotte, while solidifying a deep emotional connection with Florence. Eleanor is established as a manipulative antagonist.\\n\\n**Continuity:** Sets up a dawn extraction mission for Thursday, June 15, where Ryan and Florence lead the infiltration, supported by Howard's forces, to rescue Mina and Cora before a planned sale."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/Arcs/[ARC 001] - Arrival, Confession, and Rescue Plan.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"b1cwnq","at":1777331817896},"key":"Flora - Memory Books/Arcs/[ARC 001] - Arrival, Confession, and Rescue Plan.md#---frontmatter---","lines":[1,25],"size":1313,"outlinks":[],"class_name":"SmartBlock"},
