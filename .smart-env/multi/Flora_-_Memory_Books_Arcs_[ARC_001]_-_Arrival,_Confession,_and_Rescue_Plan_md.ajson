lan#Key Exchanges#{4}":[50,50],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{5}":[51,51],"#Arrival, Confession, and Rescue Plan#Key Exchanges#{6}":[52,53],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity":[54,61],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{1}":[55,55],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{2}":[56,56],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{3}":[57,57],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{4}":[58,58],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{5}":[59,59],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{6}":[60,60],"#Arrival, Confession, and Rescue Plan#Outcome & Continuity#{7}":[61,61]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["Eleanor Adame","Claymore Manor","Competition Petition","Smuggler's Path","Hidden Chamber","Abuse","Hostage","Kidnapping Rescue","Eleanor","Ryan","Mina","Cora","Rachael Blakeney","Blanket Code"],"position":"after","depth":4,"summary":"**What:** A narrative arc detailing Ryan's arrival at Claymore Manor, his confession of abuse by his mother Eleanor, and the formulation of a rescue plan for his sisters Mina and Cora.\\n\\n**When:** Wednesday, June 14, 1843, 2:15 PM to Thursday, June 15, 1843, 6:40 AM.\\n\\n**Context:** Ryan, suffering amnesia from a carriage accident, exposes Eleanor's torture chamber and manipulation. He unites with Rachael, Charlotte, and Florence to plan a surgical extraction using a smuggler's path, despite facing legal challenges and external threats.\\n\\n**Key Relationships:** Ryan gains a protective maternal bond with Rachael and a strategic alliance with Charlotte, while solidifying a deep emotional connection with Florence. Eleanor is established as a manipulative antagonist.\\n\\n**Continuity:** Sets up a dawn extraction mission for Thursday, June 15, where Ryan and Florence lead the infiltration, supported by Howard's forces, to rescue Mina and Cora before a planned sale."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/Arcs/[ARC 001] - Arrival, Confession, and Rescue Plan.md#---frontmatter---": {"path":null,"last_embed":{"hash":"b1cwnq","at":1777331883307},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04936595,-0.0455838,0.02683885,0.04873782,0.01026457,0.01058299,-0.01677015,-0.00864771,0.01310412,-0.0409667,0.01593181,-0.01785769,0.05091983,0.02409662,0.00898928,0.04762433,-0.0325014,0.05970486,-0.09911402,0.02912875,0.01765554,-0.06647195,-0.03503262,0.02207221,0.01187134,0.02249101,-0.0191363,-0.00233378,-0.05880108,-0.2224867,-0.06899014,0.02874689,0.05115386,-0.00932474,0.04629819,0.0236811,-0.02310432,0.06905938,0.00283537,0.00682291,-0.01406469,-0.0411103,-0.06222596,-0.00984937,-0.00208829,-0.09726968,0.05261765,0.01062873,0.04147533,-0.05101568,-0.06541649,0.03327506,-0.00980231,0.01371398,0.04457777,0.03933555,0.09016557,0.03230881,0.05542954,0.03680737,0.08417446,0.01109301,-0.16903126,0.08881437,0.0265111,0.04439264,-0.04318121,-0.03663723,0.1129715,-0.02404621,-0.07107682,0.03520505,0.00309263,0.01921478,0.03845332,0.01592689,0.04593451,0.0166305,0.01134426,-0.02830988,-0.03134311,0.0442549,-0.05715948,0.0499097,-0.03486137,-0.00359624,0.03864005,-0.07136605,-0.02824048,-0.00096882,-0.01762257,-0.04208263,0.00171066,0.0504501,-0.04873149,-0.02384684,-0.05729685,0.00940782,-0.03294707,0.0804553,0.02628981,0.03328144,-0.01422351,-0.02609494,0.07636437,-0.04245498,0.04181901,-0.11279415,-0.03928911,-0.02736567,0.04849145,-0.05879253,-0.01609638,-0.07733686,0.08625562,0.05208653,0.11431359,0.02525076,-0.04455911,-0.01443085,-0.01530279,0.03798944,0.05809874,-0.0433105,-0.05204435,-0.04808926,0.09113349,0.06016912,0.00622434,-0.05528416,0.06841248,0.05125591,-0.04979108,0.02479334,-0.04012796,0.017195,-0.01810766,-0.03291514,-0.04864199,-0.06318094,-0.05911734,-0.08287435,-0.06215914,-0.03222824,-0.08634001,0.09236114,0.