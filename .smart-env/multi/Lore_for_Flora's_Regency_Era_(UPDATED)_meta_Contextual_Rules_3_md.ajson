ber 12, 1698 (early 1700s).  \n\n**Relationships:** Defines gender hierarchy (7), family piety (8), regional social norms (10), and acceptable combat (12)."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/meta/Contextual Rules 3.md#---frontmatter---": {"path":null,"last_embed":{"hash":"12x3tsi","at":1777331881211},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[0.04013013,0.03055996,0.04351466,-0.01632941,0.00026719,0.01510783,0.04926106,-0.00349613,0.0088465,0.04651263,-0.01835096,-0.02542316,0.00932395,-0.01151128,0.03591692,0.00771141,0.00587108,0.09066018,-0.10701223,0.06582796,0.10329584,-0.05528216,-0.0145546,-0.0128112,0.04612595,-0.02444023,-0.03214855,-0.09170607,-0.06278042,-0.18321258,-0.07790893,0.03105558,0.00268538,0.06698073,-0.03026173,0.01521454,-0.02952686,-0.00638022,-0.02254172,0.03099809,0.0099154,0.03927213,0.02697306,0.02861333,-0.03621174,-0.0503367,-0.01907007,0.04278518,-0.06678618,-0.06433886,-0.01776245,0.00012636,0.02878315,0.07057729,0.0457518,0.05203562,0.08883529,-0.00079495,0.05461629,0.01139851,0.03030396,0.01819852,-0.19326794,0.15330659,-0.01515253,0.02826033,-0.01925187,0.01717197,0.02217074,0.04963353,-0.05739378,0.02482237,-0.02884463,0.05852115,0.03371654,0.04415318,-0.00157349,-0.08196508,-0.02762354,-0.03649362,-0.04531372,0.0698742,0.00089068,-0.00360579,-0.0045888,-0.01529522,0.01930524,-0.05820519,-0.03546367,0.02819791,-0.01521398,-0.03959567,-0.00404659,0.00853146,-0.03434006,-0.00242753,-0.00247802,-0.03160894,-0.02196603,0.09604688,0.04028552,0.00674484,0.0020804,0.05817772,0.10893307,0.0325898,0.02094602,-0.10012375,-0.05961229,-0.00005115,0.00667326,-0.02897444,-0.01599489,-0.02878211,-0.01801177,0.03972949,0.07717473,-0.01461859,0.01142978,-0.03172528,-0.02484288,0.01199559,0.02257532,0.01014434,0.05265967,-0.01953178,0.05117465,0.02502317,0.02705755,-0.06403659,0.067379,0.04055869,-0.06213336,-0.02690862,0.02444697,-0.02481417,-0.04115879,0.04339235,0.00800792,