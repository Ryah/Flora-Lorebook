
"smart_sources:Flora - Memory Books/058 - Post-Rescue Vigil.md": {"path":"Flora - Memory Books/058 - Post-Rescue Vigil.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"dgzjsa","at":1777331817801},"class_name":"SmartSource","last_import":{"mtime":1776821031977,"size":4150,"at":1777331817824,"hash":"dgzjsa"},"blocks":{"#---frontmatter---":[1,23],"#058 - Post-Rescue Vigil":[25,33],"#058 - Post-Rescue Vigil#{1}":[27,33]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["Valheim Monastery","Claymore Manor","Estra Hamilton","Alec Hamilton","exhausted reunion","physician Mercer","linen ankle splint","burgundy riding habit","fainting spell"],"position":"after","depth":4,"summary":"**Summary:**\\nThis entry depicts the immediate aftermath of Alec Hamilton's rescue on June 17, 1843. It should be selected to simulate post-extraction care, resource distribution, and the emotional aftermath for the rescued and rescuers. Key relationships include Ryan Adame caring for his sisters (Mina, Cora) and Charlotte Claymore; Florence Claymore recovering from a leg injury; and Estra Hamilton's tense but cooperative arrival. The narrative establishes Loren Claymore's presence and the return of the Adame sisters, who inspect Ryan's spinal injury."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/058 - Post-Rescue Vigil.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"13x2hxm","at":1777331817801},"key":"Flora - Memory Books/058 - Post-Rescue Vigil.md#---frontmatter---","lines":[1,23],"size":998,"outlinks":[],"class_name":"SmartBlock"},
