
"smart_sources:Lore for Flora's Regency Era (UPDATED)/culture/Culture - The Scarlet Knight.md": {"path":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - The Scarlet Knight.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1lede6j","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777002481308,"size":3627,"at":1777331817922,"hash":"1lede6j"},"blocks":{"#---frontmatter---":[1,19],"#Culture - The Scarlet Knight":[21,22],"#A wildly popular book series that has become a national craze in Flora.":[23,42],"#A wildly popular book series that has become a national craze in Flora.#{1}":[24,42]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["scarlet knight","roddick drakenhold","novel","book","fandom"],"position":"before","depth":4,"scanDepth":1,"summary":"The Scarlet Knight is a wildly popular book series from Flora, a national craze blending superhero, spy thriller, romance, and horror. Select this entry when a character is in Flora, interacts with Floran culture, or discusses popular fiction, romance ideals, or fandom. Key characters: Roddick Drakenhold (hero, secret identity as a witty fop), Camilla (angel sidekick), antagonists Yurika, Violet, and the Dark Mistress (secretly Countess Amy Lancaster; Charlotte Claymore notices an uncanny resemblance to herself). Fans include Florence, Priti, Rachael; closeted fans Astrid, Estra, Loren Claymore. Charlotte claims to dislike it. The series profoundly shapes the Floran ideal of the ideal man and is unofficially church-endorsed."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/culture/Culture - The Scarlet Knight.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"18xs6ma","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - The Scarlet Knight.md#---frontmatter---","lines":[1,19],"size":974,"outlinks":[],"class_name":"SmartBlock"},
