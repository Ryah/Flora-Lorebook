
"smart_sources:Lore for Flora's Regency Era (UPDATED)/_archived/Story - Slice of Life - PICK ONE.md": {"path":"Lore for Flora's Regency Era (UPDATED)/_archived/Story - Slice of Life - PICK ONE.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"chcls","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1776993493361,"size":1861,"at":1777331817922,"hash":"chcls"},"blocks":{"#---frontmatter---":[1,18],"#Story - Slice of Life - PICK ONE":[20,21],"#Gameplay Toggle: Slice of Life Mode is ACTIVE.":[22,22],"#This mode prioritizes low-stakes, character-driven interactions and daily life at the Claymore estate. The focus is on relationship dynamics, comedy, and wholesome moments.":[23,28],"#This mode prioritizes low-stakes, character-driven interactions and daily life at the Claymore estate. The focus is on relationship dynamics, comedy, and wholesome moments.#{1}":[24,28]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":120,"tags":["#lorebook","#lorebook-always"],"keys":["slice of life mode","low stakes","daily life","no threat"],"position":"after","depth":4,"scanDepth":1,"summary":"What is this: A gameplay toggle activating Slice of Life Mode for the ongoing story, shifting focus to low-stakes, character-driven daily life at the Claymore estate. Prioritizes relationship dynamics, comedy, and wholesome moments.\n\nWhen to select: When the scene should focus on domestic activities, local events in Greydall, or personal character development in a safe environment. Use when high-stakes conflict would detract from bonding, humor, or romance.\n\nKey relationships: Suspends key antagonists from active engagement: Loren Claymore, Crown Princess Cornelia, and Estra's true intent will not plot against or impact the household. Their machinations occur in the background only."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/_archived/Story - Slice of Life - PICK ONE.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"tckcrc","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/_archived/Story - Slice of Life - PICK ONE.md#---frontmatter---","lines":[1,18],"size":905,"outlinks":[],"class_name":"SmartBlock"},
