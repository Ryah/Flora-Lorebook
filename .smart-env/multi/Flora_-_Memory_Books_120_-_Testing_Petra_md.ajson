rained response; plans projection into study).","location":"Duran","scene_type":"investigation","character_present":["Ryan","Charlotte","Florence","Estra","Queen Maya","Howard"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Flora - Memory Books/120 - Testing Petra.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"15zgamf","at":1777331817827},"key":"Flora - Memory Books/120 - Testing Petra.md#---frontmatter---","lines":[1,29],"size":1730,"outlinks":[],"class_name":"SmartBlock"},
