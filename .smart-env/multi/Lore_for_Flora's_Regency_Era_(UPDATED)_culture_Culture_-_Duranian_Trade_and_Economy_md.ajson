
"smart_sources:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Duranian Trade and Economy.md": {"path":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Duranian Trade and Economy.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1fisli0","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1777002481298,"size":1947,"at":1777331817921,"hash":"1fisli0"},"blocks":{"#---frontmatter---":[1,25],"#Culture - Duranian Trade and Economy":[27,28],"#The trade-dependent, quality-focused economy of Duran.":[29,33],"#The trade-dependent, quality-focused economy of Duran.#{1}":[30,33]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":50,"tags":["#lorebook"],"keys":["duranian economy","duranian trade","floran trade","artisans"],"refine_keys":["duran","duranian","trade","economy","merchant","market"],"position":"before","depth":4,"scanDepth":1,"summary":"Duran's economy is trade-dependent, importing raw materials to export high-value luxury goods (jewelry, clockwork, art, fashion). Selected when discussing commerce, shipping, or political/economic relations with Flora, especially regarding piracy, trade routes, or luxury goods. Key relationship: economic dependency on Flora, as Duranian merchants pay Floran matriarchs/naval captains for armed escorts. This creates political friction in Flora between trade-focused blocs (seeking normalized relations) and hawkish/isolationist factions."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/culture/Culture - Duranian Trade and Economy.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"2vp62k","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/culture/Culture - Duranian Trade and Economy.md#---frontmatter---","lines":[1,25],"size":840,"outlinks":[],"class_name":"SmartBlock"},
