
"smart_sources:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Rainbridge University.md": {"path":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Rainbridge University.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"j4dv8k","at":1777331817895},"class_name":"SmartSource","last_import":{"mtime":1776992823766,"size":2054,"at":1777331817922,"hash":"j4dv8k"},"blocks":{"#---frontmatter---":[1,19],"#Locations - Rainbridge University":[21,22],"#The preeminent university in Flora, known for its academic and research excellence.":[23,31],"#The preeminent university in Flora, known for its academic and research excellence.#{1}":[24,31]},"outlinks":[],"metadata":{"type":"lore","status":"active","priority":100,"tags":["#lorebook"],"keys":["rainbridge","university","college","education","somme"],"position":"before","depth":4,"scanDepth":1,"summary":"**Rainbridge University** is the premier institution of higher learning in Flora, located near the capital Tor Veiloth. Select this entry when characters are students, faculty, or alumni; when events involve elite education, academic research, athletics, or religious studies; or when the plot concerns social mobility through academic or athletic merit. Key relationships: Charlotte Claymore (academic alumna), Florence Blakeney (athletic alumna). The university is highly selective, admitting only wealthy, high-ranking, gifted, or athletic individuals. Its student body is majority female nobles, with a notable minority of male students excelling in math, research, or athletics. Curriculum includes mandatory religious courses."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Lore for Flora's Regency Era (UPDATED)/locations/Locations - Rainbridge University.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"22x42s","at":1777331817895},"key":"Lore for Flora's Regency Era (UPDATED)/locations/Locations - Rainbridge University.md#---frontmatter---","lines":[1,19],"size":948,"outlinks":[],"class_name":"SmartBlock"},
